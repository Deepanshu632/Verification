# Required to enable /admin. Use a long, random value and keep it private.
ADMIN_TOKEN=vdjnjdv9909dwiewjjf3308jfnd

# Groq model key: used by the extraction agent, government research agent, and reports.
GROQ_API_KEY=paste_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Required for the government-domain web search step of the agent workflow.
TAVILY_API_KEY= 

# Optional: enables LangSmith tracing for the local LangGraph workflow.
LANGSMITH_API_KEY=

# Set to 1 when served over HTTPS.
COOKIE_SECURE=0

# Optional persistent data location.
# DATA_DIR=/absolute/path/to/data
